# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — Home isolation Vitest (tests/home/tenant-isolation). Never NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Demo login (local/staging only — omit or set false in production)
ENABLE_DEMO_LOGIN=true
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=DemoPass123!
# Fixed month for demo user when ?month= is missing (YYYY-MM; must match seeded data)
DEMO_DEFAULT_MONTH=2026-06
# Optional fixed "today" for demo Home Today / quick-record (YYYY-MM-DD; defaults to 15th of DEMO_DEFAULT_MONTH)
DEMO_DEFAULT_TODAY=2026-06-15

# Home tenant-isolation test users (from migration 044 — do not use as daily logins)
# ISOLATION_USER_A_ID=a2222222-2222-4222-8222-222222222222
# ISOLATION_USER_A_EMAIL=isolation-a@example.com
# ISOLATION_USER_B_ID=b3333333-3333-4333-8333-333333333333
# ISOLATION_USER_B_EMAIL=isolation-b@example.com
# ISOLATION_USER_PASSWORD=IsolationPass123!

# OpenWeatherMap API key (server-only — used by World Time weather row)
# https://openweathermap.org/api
WEATHER_API_KEY=
